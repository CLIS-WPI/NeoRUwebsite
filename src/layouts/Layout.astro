---
import { Image } from 'astro:assets';
import miniLogo from '../assets/neoru-mini-logo.png';
import { url } from '../lib/site';
import '../styles/global.css';
import '../styles/pages.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const nav = [
  ['Home', 'home'],
  ['Architecture', 'architecture'],
  ['Benchmarks', 'benchmarks'],
  ['Roadmap', 'roadmap'],
  ['Docs', 'docs'],
  ['About', 'about'],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = url();
const sectionHref = (id: string) => `${homeUrl}#${id}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/favicon-192x192.png`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'NeoRU',
      url: new URL(homeUrl, Astro.site).href,
      description,
      publisher: {
        '@type': 'ResearchOrganization',
        name: 'CLIS Lab, Worcester Polytechnic Institute',
      },
    },
    {
      '@type': 'SoftwareSourceCode',
      name: 'NeoRU',
      description: 'Open-source, software-defined Open Radio Unit (O-RU) for O-RAN 7.2x fronthaul.',
      codeRepository: 'https://github.com/CLIS-WPI/NeoRU/',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      author: {
        '@type': 'Person',
        name: 'Milad Natanzi',
      },
      url: canonical.href,
    },
  ],
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | NeoRU</title><meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="LLMs.txt — AI-readable site index" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:site_name" content="NeoRU" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={`${title} | NeoRU`} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | NeoRU`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={homeUrl} aria-label="NeoRU home"><span class="brand-icon"><Image src={miniLogo} width={256} height={256} format="webp" alt="" /></span><span class="brand-copy"><span>Neo<span class="brand-weight">RU</span></span><small>Intelligence Radio Systems</small></span></a>
        <nav class="desktop-nav" aria-label="Main navigation">{nav.slice(0, -1).map(([label,id])=><a href={sectionHref(id)} data-section={id}>{label}</a>)}<span class="nav-paper" aria-disabled="true">Paper</span>{nav.slice(-1).map(([label,id])=><a href={sectionHref(id)} data-section={id}>{label}</a>)}</nav>
        <div class="header-actions">
          <a class="github-link" href="https://github.com/CLIS-WPI/NeoRU/" aria-label="Project repository on GitHub" title="NeoRU project repository">GitHub</a>
          <details class="mobile-nav"><summary aria-label="Open navigation"><span></span><span></span></summary><nav aria-label="Mobile navigation">{nav.slice(0, -1).map(([label,id])=><a href={sectionHref(id)} data-section={id}>{label}</a>)}<span class="nav-paper" aria-disabled="true">Paper</span>{nav.slice(-1).map(([label,id])=><a href={sectionHref(id)} data-section={id}>{label}</a>)}<a href="https://github.com/CLIS-WPI/NeoRU/" aria-label="Project repository on GitHub">GitHub</a></nav></details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container">
      <div class="footer-top"><div><a class="footer-brand" href={homeUrl}>NeoRU</a><p>Open radio.<br />Rigorous engineering.</p></div><div class="footer-links"><div><span>Project</span><a href={sectionHref('architecture')}>Architecture</a><a href={sectionHref('benchmarks')}>Benchmarks</a><a href={sectionHref('roadmap')}>Roadmap</a></div><div><span>Explore</span><a href={url('docs')}>Docs</a><a href={url('how-we-build')}>How we build</a><a href={url('publications')}>Publications</a><a href={sectionHref('about')}>About & contact</a></div><div><span>Developed at</span><p>CLIS Lab<br />Electrical & Computer Engineering<br />Worcester Polytechnic Institute</p></div></div></div>
      <div class="footer-bottom"><span>Apache 2.0 · Public code release pending</span><a class="repository-link" href="https://github.com/CLIS-WPI/NeoRU/">Project repository on GitHub</a><span>Project status: 23 November 2026</span></div>
      <p class="trademark">O-RAN is a trademark of the O-RAN Alliance. Used descriptively; no affiliation or endorsement is implied.</p>
    </div></footer>
    <script>
      const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileMenu?.open) {
          mobileMenu.open = false;
          mobileMenu.querySelector('summary')?.focus();
        }
      });
      mobileMenu?.querySelectorAll('nav a').forEach((link) => {
        link.addEventListener('click', () => {
          if (mobileMenu) mobileMenu.open = false;
        });
      });

      const sections = ['home', 'architecture', 'benchmarks', 'roadmap', 'docs', 'about']
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);
      if (sections.length > 0) {
        const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a[data-section]'));
        const setActive = (id: string) => {
          navLinks.forEach((a) => {
            if (a.dataset.section === id) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        };
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
            if (visible?.target.id) setActive(visible.target.id);
          },
          { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.2, 0.5] },
        );
        sections.forEach((s) => observer.observe(s));
      }
    </script>
  </body>
</html>
