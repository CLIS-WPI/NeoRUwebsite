---
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import neoRuOwlLogo from '../assets/neoru-owl-cropped.png';
import ocuNodeImg from '../assets/ocu-node.png';
import oduNodeImg from '../assets/odu-node.png';
import oruNodeImg from '../assets/oru-node.png';
import oruClosedImg from '../assets/oru-closed.png';
import oruOpenImg from '../assets/oru-open.png';
import Layout from '../layouts/Layout.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import RoadmapStepper from '../components/RoadmapStepper.astro';
import { OranHeroSection } from '../components/oran-hero/OranHeroSection';
import { BlackBoxSection } from '../components/black-box/BlackBoxSection';
import { url } from '../lib/site';
import roadmap from '../data/milestones.json';

const homePage = await getEntry('pages', 'home');
const archPage = await getEntry('pages', 'architecture');
const roadPage = await getEntry('pages', 'roadmap');
if (!homePage || !archPage || !roadPage) {
  throw new Error('Required home page content is missing.');
}

const { Content: HomeContent } = await render(homePage);
const { Content: ArchContent } = await render(archPage);
const { Content: RoadContent } = await render(roadPage);

const neoRuMark = await getImage({ src: neoRuOwlLogo, width: 320, format: 'webp' });
const ocuNodeWebp = await getImage({ src: ocuNodeImg, width: 720, format: 'webp' });
const oduNodeWebp = await getImage({ src: oduNodeImg, width: 760, format: 'webp' });
const oruNodeWebp = await getImage({ src: oruNodeImg, width: 760, format: 'webp' });
const oruClosedWebp = await getImage({ src: oruClosedImg, width: 1000, format: 'webp' });
const oruOpenWebp = await getImage({ src: oruOpenImg, width: 1000, format: 'webp' });
const asOf = new Date(`${roadmap.asOf}T12:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const docCards = [
  {
    tag: 'Start here',
    title: 'Getting Started',
    description: 'Repository status, Apache 2.0 licensing, completed foundations, and documentation structure.',
    href: url('docs/getting-started'),
  },
  {
    tag: 'System design',
    title: 'Architecture & Real-Time Core',
    description: 'Control process, slot clock, event ring, executor, GenMC hand-off, and deterministic virtual radio.',
    href: url('docs/architecture'),
  },
  {
    tag: 'Verification',
    title: 'Engineering & Benchmarks',
    description: 'Spec-first workflow, CI sanitizer gates, and ProtO-RU reference baseline conditions.',
    href: url('docs/engineering'),
  },
];
---

<Layout title="A software radio unit. Built to be measured." description={homePage.data.description}>
  {/* Slide 1: High-Craft 2.5D O-RAN 7.2x Split Hardware Hero */}
  <OranHeroSection
    client:load
    neoRuLogoSrc={neoRuMark.src}
    ocuImageSrc={ocuNodeWebp.src}
    oduImageSrc={oduNodeWebp.src}
    oruImageSrc={oruNodeWebp.src}
  />

  {/* Slide 2: High-Craft 2.5D "Opening the O-RU Black Box" */}
  <BlackBoxSection
    client:visible
    closedImageSrc={oruClosedWebp.src}
    openImageSrc={oruOpenWebp.src}
  />

  <section class="section container">
    <div class="section-intro">
      <div>
        <p class="eyebrow">The engineering approach</p>
        <h2>Six commitments.<br />One coherent design.</h2>
      </div>
      <p>Precision is more than a performance figure. It is how a system is specified, tested and understood.</p>
    </div>
    <div class="principles"><HomeContent /></div>
  </section>

  {/* Section: Architecture */}
  <section id="architecture" class="home-anchor-section home-band-surface" aria-labelledby="sec-arch-title">
    <div class="container">
      <div class="home-section-head">
        <p class="eyebrow">{archPage.data.eyebrow}</p>
        <h2 id="sec-arch-title">{archPage.data.title}</h2>
        <p class="home-section-lead">{archPage.data.description}</p>
      </div>
      <ArchitectureDiagram />
      <div class="architecture-reading">
        <aside class="reading-aside">
          <p class="eyebrow">Design principle</p>
          <p>Make timing explicit.<br />Keep the claim bounded.</p>
          <a class="text-link" href="#roadmap">See implementation status</a>
        </aside>
        <article class="prose"><ArchContent /></article>
      </div>
    </div>
  </section>

  {/* Section: Benchmarks (intentionally left as clean background band for now) */}
  <section id="benchmarks" class="home-anchor-section home-benchmarks-empty" aria-label="Benchmarks"></section>

  {/* Section: Roadmap */}
  <section id="roadmap" class="home-anchor-section home-band-surface" aria-labelledby="sec-road-title">
    <div class="container">
      <div class="home-section-head">
        <p class="eyebrow">{roadPage.data.eyebrow}</p>
        <h2 id="sec-road-title">{roadPage.data.title}</h2>
        <p class="home-section-lead">{roadPage.data.description}</p>
      </div>
      <div class="roadmap-introduction">
        <div class="prose"><RoadContent /></div>
        <p class="roadmap-datestamp">Status as of <time datetime={roadmap.asOf}>{asOf}</time></p>
      </div>
      <RoadmapStepper headingLevel={3} idPrefix="home-roadmap" />
    </div>
  </section>

  {/* Section: Docs (Entry Gateway into Fumadocs) */}
  <section id="docs" class="home-anchor-section" aria-labelledby="sec-docs-title">
    <div class="container">
      <div class="home-docs-header">
        <div>
          <p class="eyebrow">Documentation</p>
          <h2 id="sec-docs-title">Explore the NeoRU documentation.</h2>
          <p class="home-section-lead">
            Structured engineering documentation covering architecture, real-time core design, virtual radio, and measurement methodology — with instant client-side search.
          </p>
        </div>
        <a class="button home-docs-cta" href={url('docs')}>Open Documentation</a>
      </div>
      <div class="docs-links">
        {docCards.map((entry) => (
          <a class="docs-entry" href={entry.href}>
            <span class="eyebrow">{entry.tag}</span>
            <h3>{entry.title}</h3>
            <p>{entry.description}</p>
            <span class="docs-entry-action">Read in Docs →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Section: About */}
  <section id="about" class="home-anchor-section about-flagship" aria-labelledby="sec-about-title">
    <div class="container about-shell">
      <header class="about-header">
        <p class="eyebrow">People</p>
        <h2 id="sec-about-title">About</h2>
        <p class="about-lead">Open-source radio systems research at CLIS Lab, Worcester Polytechnic Institute.</p>
      </header>
      <div class="about-cards">
        <article class="about-card about-card-founder">
          <div class="about-monogram" aria-hidden="true">MN</div>
          <div class="about-card-body">
            <span class="about-role">Founder</span>
            <h3>Milad Natanzi</h3>
            <p class="about-affil">CLIS Lab · ECE, WPI</p>
          </div>
        </article>
        <article class="about-card">
          <div class="about-monogram" aria-hidden="true">BT</div>
          <div class="about-card-body">
            <span class="about-role">Advisor</span>
            <h3>Bo Tang</h3>
            <p class="about-affil">CLIS Lab · ECE, WPI</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>
