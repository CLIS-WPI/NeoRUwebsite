---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/neoru-logo.png';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/site';
import roadmap from '../data/milestones.json';
const page = await getEntry('pages','home');
if(!page) throw new Error('Home content is missing');
const { Content }=await render(page);
const statusGroups=[{status:'done',label:'Done',title:'Foundations in place',copy:'Specifications, CI gates, the baseline method, BFP codec and deterministic virtual radio.'},{status:'in_progress',label:'In progress',title:'The real-time core',copy:'Phase 1: timing, execution, host checks and the verified configuration hand-off.'},{status:'planned',label:'Planned',title:'Integration, then evidence',copy:'Fronthaul I/O, real-DU testing and a matched comparison on the radio bench.'}];
---
<Layout title="A software radio unit. Built to be measured." description={page.data.description}>
  <section class="hero container">
    <p class="eyebrow">CLIS Lab · Worcester Polytechnic Institute</p>
    <h1>A software radio unit.<br /><span>Built to be measured.</span></h1>
    <p class="hero-description">{page.data.description}</p>
    <div class="hero-actions"><a class="button" href={url('architecture')}>Explore the architecture</a><a class="text-link" href={url('benchmarks')}>View benchmarks</a></div>
    <div class="hero-art"><div class="art-label">Software O-RU<br />Open Fronthaul · Split 7.2x</div><div class="hero-logo"><Image src={logo} width={512} height={512} format="webp" alt="NeoRU owl and radio-wave logo" loading="eager" fetchpriority="high" /></div><div class="art-label right">An open engineering project<br />Apache 2.0</div></div>
    <p class="art-caption">Software-defined research. Public code release pending.</p>
    <div class="project-strip"><div><span>Current focus</span><p>Phase 1 · Core foundations</p></div><div><span>Engineering principle</span><p>Measured, not claimed.</p></div><div><span>Development model</span><p>Open. Traceable. Human-reviewed.</p></div></div>
  </section>
  <section class="section container"><div class="section-intro"><div><p class="eyebrow">The engineering approach</p><h2>Six commitments.<br />One coherent design.</h2></div><p>Precision is more than a performance figure. It is how a system is specified, tested and understood.</p></div><div class="principles"><Content /></div></section>
  <section class="evidence-band"><div class="container evidence-inner"><div><p class="eyebrow">Benchmarks</p><h2>A baseline comes<br />before a comparison.</h2><p>Inspect the reference measurements and their conditions. NeoRU has not yet been measured end to end.</p></div><a class="button" href={url('benchmarks')}>Explore the baseline</a></div></section>
  <section class="section container"><div class="section-intro"><div><p class="eyebrow">A project in the open</p><h2>Progress, made visible.</h2></div><p class="date-label">Status as of {new Date(`${roadmap.asOf}T00:00:00Z`).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}.<br />A record of the work, without invented deadlines.</p></div><div class="status-preview">{statusGroups.map(group=><article><span class={`status status-${group.status}`}>{group.label}</span><h3>{group.title}</h3><p>{roadmap.milestones.filter(m=>m.status===group.status).map(m=>m.title).slice(0,3).join(' · ')}.</p><a class="text-link" href={`${url('roadmap')}#${group.status.replace('_','-')}`}>View milestones</a></article>)}</div></section>
  <section class="container home-process"><div><h2>The process is part of the product.</h2><p>Specifications first. Tests first. Human judgment at every gate.</p></div><a class="text-link" href={url('how-we-build')}>How we build NeoRU</a></section>
</Layout>
