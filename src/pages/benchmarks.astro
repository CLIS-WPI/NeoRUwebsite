---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import baseline from '../data/benchmarks.json';
import { url } from '../lib/site';
const page = await getEntry('pages', 'benchmarks');
if (!page) throw new Error('Benchmarks content is missing.');
const { Content } = await render(page);
---
<Layout title={page.data.title} description={page.data.description}>
  <PageHeading {...page.data} />
  <section class="container benchmark-content" aria-labelledby="baseline-title">
    <div class="benchmark-panel">
      <div class="benchmark-panel-header">
        <div><p class="eyebrow">{baseline.label}</p><h2 id="baseline-title">{baseline.implementation}</h2></div>
        <span class="baseline-badge">Reference measurement</span>
      </div>
      <div class="benchmark-table-wrap">
        <table class="benchmark-table">
          <caption class="visually-hidden">{baseline.label}: {baseline.implementation} measurements and scope</caption>
          <thead><tr><th scope="col">Measurement</th><th scope="col">Result</th><th scope="col">Measurement scope</th></tr></thead>
          <tbody>{baseline.metrics.map((metric) => (
            <tr><th scope="row">{metric.label}</th><td><strong class="benchmark-value">{metric.value}</strong><span class="benchmark-unit">{metric.unit}</span></td><td>{metric.scope}</td></tr>
          ))}</tbody>
        </table>
      </div>
      <div class="benchmark-conditions">
        <h3>Conditions matter.</h3>
        <dl>{baseline.conditions.map((condition) => (<div><dt>{condition.label}</dt><dd>{condition.value}</dd></div>))}</dl>
      </div>
    </div>
    <p class="evidence-note"><span>Measurement record</span>{baseline.evidenceNote}</p>
    <div class="benchmark-reading"><article class="prose"><Content /></article></div>
    <div class="page-crosslink"><span>From the reference run to a matched comparison.</span><a class="text-link" href={url('roadmap')}>Follow the roadmap</a></div>
  </section>
</Layout>
