---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { url } from '../lib/site';
const page = await getEntry('pages', 'how-we-build');
if (!page) throw new Error('Engineering process content is missing.');
const { Content } = await render(page);
---
<Layout title={page.data.title} description={page.data.description}>
  <PageHeading {...page.data} />
  <section class="container process-layout" aria-label="Engineering process">
    <aside class="process-aside"><div class="process-principle"><span class="eyebrow">Human-approved gates</span><p>Every change<br />leaves a record.</p><span class="process-rule" aria-hidden="true"></span><p class="process-aside-small">Specifications establish intent. Tests exercise it. Review owns the decision.</p></div><a class="text-link" href={url('roadmap')}>View current progress</a></aside>
    <article class="prose process-prose"><Content /></article>
  </section>
</Layout>
