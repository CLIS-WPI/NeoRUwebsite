---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { url } from '../lib/site';
const page = await getEntry('pages', 'publications');
if (!page) throw new Error('Publications content is missing.');
const { Content } = await render(page);
---
<Layout title={page.data.title} description={page.data.description}>
  <PageHeading {...page.data} />
  <section class="container publications-content" aria-label="Publication record">
    <div class="publication-sheet"><svg viewBox="0 0 64 64" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M19 10h23l9 9v35H19z"/><path d="M42 10v10h9M13 17H9v42h34v-5M27 30h16M27 37h16M27 44h10"/></svg><article class="prose"><Content /></article></div>
    <a class="text-link" href={url('how-we-build')}>Explore the engineering process</a>
  </section>
</Layout>
