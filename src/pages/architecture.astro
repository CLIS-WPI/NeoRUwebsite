---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import { url } from '../lib/site';
const page = await getEntry('pages', 'architecture');
if (!page) throw new Error('Architecture content is missing.');
const { Content } = await render(page);
---
<Layout title={page.data.title} description={page.data.description}>
  <PageHeading {...page.data} />
  <section class="container architecture-section" aria-label="Architecture overview">
    <ArchitectureDiagram />
    <div class="architecture-reading">
      <aside class="reading-aside">
        <p class="eyebrow">Design principle</p>
        <p>Make timing explicit.<br />Keep the claim bounded.</p>
        <a class="text-link" href={url('roadmap')}>See implementation status</a>
      </aside>
      <article class="prose"><Content /></article>
    </div>
  </section>
</Layout>
