---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
const page = await getEntry('pages', 'team');
if (!page) throw new Error('Team content is missing.');
const { Content } = await render(page);
---
<Layout title={page.data.title} description={page.data.description}>
  <PageHeading {...page.data} />
  <section class="container team-content" aria-label="NeoRU team">
    <div class="team-people">
      <article class="team-person"><div class="person-monogram" aria-hidden="true">MN</div><div><p class="eyebrow">Development</p><h2>Milad Natanzi</h2><p>NeoRU developer</p></div></article>
      <article class="team-person"><div class="person-monogram" aria-hidden="true">BT</div><div><p class="eyebrow">Research advisor</p><h2>Bo Tang</h2><p>Advisor</p></div></article>
    </div>
    <div class="team-details"><div class="team-affiliation-label"><span class="eyebrow">Where the work happens</span><p>CLIS Lab<br /><strong>Worcester Polytechnic Institute</strong></p></div><article class="prose"><Content /></article></div>
  </section>
</Layout>
