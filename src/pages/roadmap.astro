---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import roadmap from '../data/milestones.json';
const page = await getEntry('pages', 'roadmap');
if (!page) throw new Error('Roadmap content is missing.');
const { Content } = await render(page);
const groups = [...new Set(roadmap.milestones.map((milestone) => milestone.group))];
const labels: Record<string, string> = { done: 'Done', in_progress: 'In progress', planned: 'Planned' };
const asOf = new Date(`${roadmap.asOf}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Layout title={page.data.title} description={page.data.description}>
  <PageHeading {...page.data} />
  <section class="container roadmap-content" aria-label="Development milestones">
    <div class="roadmap-introduction"><div class="prose"><Content /></div><p class="roadmap-datestamp">Status as of <time datetime={roadmap.asOf}>{asOf}</time></p></div>
    <div class="roadmap-timeline">
      {groups.map((group) => {
        const milestones = roadmap.milestones.filter((milestone) => milestone.group === group);
        const groupStatus = milestones.every((item) => item.status === milestones[0].status) ? milestones[0].status : 'in_progress';
        return (
          <section id={group === 'Foundation' ? 'done' : group === 'Phase 1' ? 'in-progress' : group === 'Phase 2' ? 'planned' : undefined} class={`roadmap-group roadmap-group-${groupStatus}`} aria-labelledby={`group-${group.toLowerCase().replaceAll(' ', '-')}`}>
            <header class="roadmap-group-heading"><span class="roadmap-node" aria-hidden="true"></span><h2 id={`group-${group.toLowerCase().replaceAll(' ', '-')}`}>{group}</h2><span class={`status status-${groupStatus}`}>{labels[groupStatus]}</span></header>
            <ul class="milestone-list">{milestones.map((milestone) => (<li id={milestone.id}><h3>{milestone.title}</h3><p>{milestone.summary}</p>{milestone.status !== groupStatus && <span class={`status status-${milestone.status}`}>{labels[milestone.status]}</span>}</li>))}</ul>
          </section>
        );
      })}
    </div>
  </section>
</Layout>
